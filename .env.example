# Base URL of the Substack publication (no trailing slash needed).
NEXT_PUBLIC_SUBSTACK_URL=https://thepoeticgeneralist.substack.com

# Optional: public site URL for metadata, sitemap and Open Graph.
# On Vercel this is inferred from the production domain if you leave it blank.
NEXT_PUBLIC_SITE_URL=

# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour.
# Create a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

# Optional: set to "true" to render the Substack embed iframe in the Subscribe block.
NEXT_PUBLIC_SUBSTACK_EMBED=false
